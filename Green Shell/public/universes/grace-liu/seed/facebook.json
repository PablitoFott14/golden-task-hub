   "id": "fbp_4357",
   "author_id": "fbu_1001",
   "message": "Sent Kevin the first batch of scans from my box of old prints. If anyone has photos from Mom's early years at the hospital, those would be wonderful for the board 😊",
   "created_at": "2026-10-18T17:10:26Z",
   "visibility": "group",
   "page_id": null,
   "group_id": "fbgr_351"
  },
  {
   "id": "fbp_4358",
   "author_id": "fbu_1212",
   "message": "Wouldn't miss it. I hired Helen in 1995 and she ran a tighter pharmacy than I ever did. My wife and I will both be there.",
   "created_at": "2026-10-20T21:48:55Z",
   "visibility": "group",
   "page_id": null,
   "group_id": "fbgr_351"
  },
