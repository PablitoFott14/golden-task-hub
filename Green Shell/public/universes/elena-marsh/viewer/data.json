  "PERSONA": {
   "name": "Elena Marsh, 47",
   "subtitle": "Owner, Marsh & Mill Bakehouse LLC · Marsh & Mill Bakehouse LLC",
   "identity": [
    {
     "key": "Name",
     "value": "Elena Marsh, 47"
    },
    {
     "key": "Home",
     "value": "214 Westwood Pl, Asheville, NC 28806 (West Asheville). She owns the house."
    },
    {
     "key": "Business",
     "value": "Elena owns Marsh & Mill Bakehouse LLC. It is a single-member LLC that she opened in 2019 after years in restaurant management. She has no boss. She answers to herself, her CPA and her bank."
    },
    {
     "key": "Café",
     "value": "731 Haywood Rd, Asheville, NC 28806. Open Wed-Sun 07:00-15:00. Closed Mon-Tue, which are her admin days."
    },
    {
     "key": "Market",
     "value": "She runs a Saturday stand at the North Asheville Farmers Market, 08:00-12:00. The season runs until the Saturday before Thanksgiving. Luis runs the café on Saturdays."
    },
    {
     "key": "Daily rhythm",
     "value": "She starts baking at 04:00 on café days. The night before a café day (Tue-Sat nights) she is in bed by about 20:30 and up at 03:30. On Sunday and Monday nights she sleeps from about 22:00 to 06:30."
    },
    {
     "key": "Contact",
     "value": "Two addresses, each with its own job. Work, elena@marshandmill.com: her email inbox (suppliers, Hal, Priscilla, the county and the market board all write here) and her login for Slack, Airtable and Apple Health. Personal, elena.marsh.avl@gmail.com: her login for the money and travel apps (Plaid, Fintrack, Duffel) and for her Facebook, Instagram and Messenger accounts. She doesn't use it as a mailbox. Cell (828) 555-0142. Café line (828) 555-0147."
    },
    {
     "key": "Family",
     "value": "Divorced. Her daughter Hazel, 19, is a sophomore at UNC Chapel Hill."
    },
    {
     "key": "How she works",
     "value": "She is organised in the kitchen, but paperwork piles up. She does her own bookkeeping all year and hands it to Priscilla for tax planning and filing. She is strict about keeping business and personal money apart."
    },
    {
     "key": "How she likes answers",
     "value": "Short and direct, with numbers."
    }
   ],
