  {
   "id": "ms_thread_4b7e09d2",
   "title": "R.",
   "created_at": "2026-09-20T00:40:12.318402Z",
   "updated_at": "2026-10-28T01:26:31.157869Z",
   "participant_ids": [
    "ms_user_owen",
